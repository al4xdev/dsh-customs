{
  "name": "@alex/mobile-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first chat shell for the existing DSH companion profile",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/start.mjs",
    "test": "node --test test/*.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.18.10",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  },
  "engines": { "node": ">=22" }
}

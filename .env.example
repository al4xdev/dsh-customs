# DSH Customs — Environment Configuration Template
# Copy this file to .env or export the variables in your shell profile.

# ==============================================================================
# 1. Base Directories & Runtime Paths
# ==============================================================================
# Root directory where DSH configuration and profiles reside (default: ~/.dsh)
# DSH_HOME=/home/username/.dsh

# Standard XDG base directory overrides
# XDG_DATA_HOME=/home/username/.local/share
# XDG_CACHE_HOME=/home/username/.cache

# ==============================================================================
# 2. Companion & Mobile Remote Access
# ==============================================================================
# Public HTTPS origin used by Companion download/transport and Android pairing.
# (Default fallback in development: https://dsh.tail37b3d7.ts.net:8443)
# Set this to your Tailscale MagicDNS endpoint, VPS domain, or custom reverse proxy:
DSH_COMPANION_ORIGIN=https://your-node.ts.net:8443

# Host:port string expected by web-runtime and connection headers (matches ORIGIN)
DSH_COMPANION_HOST=your-node.ts.net:8443

# Optional custom path to DSH companion CLI binary
# DSH_COMPANION_CLI=/home/username/.local/share/dsh-cli/lib/bin.js

# Custom node_modules runtime location for mobile companion builds
# DSH_RUNTIME_NODE_MODULES=/home/username/.local/share/dsh-cli/node_modules

# ==============================================================================
# 3. Local Model Inference (llama-server / llama.cpp / GGUF)
# ==============================================================================
# Base URL for local OpenAI-compatible inference server (default: http://127.0.0.1:8080/v1)
# DSH_LOCAL_URL=http://127.0.0.1:8080/v1

# Pinned local model ID when multiple models are advertised by /v1/models
# DSH_LOCAL_MODEL=

# Pinned model descriptors (optional override for GGUF model identifier strings)
# DSH_LOCAL_GEMMA_ID=
# DSH_LOCAL_GEMMA_STYLETUNE_ID=

# Pinned default provider, model, and reasoning effort
# DSH_DEFAULT_PROVIDER=openai-codex
# DSH_DEFAULT_MODEL=gpt-6-sol
# DSH_DEFAULT_EFFORT=low

# ==============================================================================
# 4. Plugins & Integrations
# ==============================================================================
# [research] Context7 documentation library API token (optional)
# CONTEXT7_API_KEY=

# [music] MCP Music Player project directory and uv executable (optional)
# SIMP_MCP_PROJECT=/home/username/git/my/simp_mcp
# SIMP_MCP_UV=uv

# [grammar-fix] Backend URL and models for grammar correction plugin
# LLAMACPP_BASE_URL=http://127.0.0.1:8080
# GRAMMAR_GPT_MODEL=openai-codex/gpt-6-sol
# GRAMMAR_GEMINI_MODEL=google-antigravity/gemini-3.8-flash-low
# GRAMMAR_LOCAL_MODEL=

# [project-mcp] Test logging path (optional)
# PROJECT_MCP_TEST_LOG=/tmp/project-mcp.log

.dumps/
# No trailing slash: host/Docker installs make the root node_modules a symlink.
node_modules
__pycache__/
*.pyc

# Mutable plan registry stays local; only reviewed Markdown artifacts are source.
.plan/.state/

# Packed frontend build consumed by the task10 profile wiring. A build output,
# not source: it is large and reproduced by tools/task10-frontend/bootstrap.mjs.
tools/task10-frontend/artifacts/

# Nested git repository with its own remote (ccch1mneyyy/dsh-TUI). Tracked
# separately on purpose: absorbing it here would swallow 876 MB and bury its
# own history. Sync it with `git -C frontend/dsh-tui ...`, not from this repo.
frontend/dsh-tui/

# Nested git repository with its own remote (OpenSaozi/dsh-antigravity).
plugins/dsh-antigravity/

# Recovered Pi source is vendored in sources/pi-ai for clean-clone builds.
# SOURCE-PROVENANCE.json records a verified snapshot, not a nested Git HEAD.

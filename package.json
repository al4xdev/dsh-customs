{
  "name": "alex-dsh-machine-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node tools/activate.mjs",
    "activate": "node tools/activate.mjs --write",
    "test:project-mcp": "node --test plugins/project-mcp/project-mcp.test.mjs",
    "test:grammar": "node --test plugins/grammar-fix/grammar-fix.test.mjs plugins/grammar-fix/language-alias.test.mjs && node tools/task10-profile/grammar-config-check.mjs",
    "test:grammar:live": "node plugins/grammar-fix/live-check.mjs",
    "test:lts:contracts": "node --test plugins/apply-patch/apply-patch.test.mjs plugins/list/list.test.mjs plugins/grammar-fix/grammar-fix.test.mjs plugins/grammar-fix/language-alias.test.mjs plugins/trash/trash.test.mjs plugins/clipboard/clipboard.test.mjs plugins/workspace-context/workspace-context.test.mjs && node tools/task10-profile/grammar-config-check.mjs",
    "test:trash": "node --test plugins/trash/trash.test.mjs",
    "test:clipboard": "node --test plugins/clipboard/clipboard.test.mjs",
    "test:workspace-context": "node --test plugins/workspace-context/workspace-context.test.mjs",
    "test:list": "node --test plugins/list/list.test.mjs",
    "test:apply-patch": "node --test plugins/apply-patch/apply-patch.test.mjs",
    "workshop:doctor": "node tools/workshop/bootstrap.mjs --doctor",
    "test:workshop": "node --test tools/workshop/*.test.mjs",
    "test:managed-plans": "node --test plugins/managed-plans/*.test.mjs && node tools/task10-profile/refinements-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "yaml": "2.9.1"
  }
}

{
  "name": "alex-dsh-machine-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node tools/activate.mjs",
    "activate": "node tools/activate.mjs --write",
    "browser:doctor": "node tools/browser-runtime.mjs --doctor",
    "browser:install": "node tools/browser-runtime.mjs --install",
    "test:browser": "node tools/browser-tests.mjs",
    "test:browser:live": "node tools/browser-tests.mjs --live",
    "test:lts:contracts": "node --test plugins/apply-patch/apply-patch.test.mjs plugins/list/list.test.mjs plugins/grammar-fix/grammar-fix.test.mjs plugins/grammar-fix/language-alias.test.mjs plugins/trash/trash.test.mjs plugins/clipboard/clipboard.test.mjs plugins/workspace-context/workspace-context.test.mjs && node tools/task10-profile/grammar-config-check.mjs",
    "test:trash": "node --test plugins/trash/trash.test.mjs",
    "test:wait": "node --test plugins/wait/wait.test.mjs plugins/wait/schedule.test.mjs",
    "test:peak-gate": "node --test plugins/peak-gate/gate.test.mjs plugins/peak-gate/index.test.mjs",
    "peak:plan": "node plugins/peak-gate/plan.mjs",
    "test:clipboard": "node --test plugins/clipboard/clipboard.test.mjs",
    "test:workspace-context": "node --test plugins/workspace-context/workspace-context.test.mjs",
    "test:list": "node --test plugins/list/list.test.mjs",
    "test:apply-patch": "node --test plugins/apply-patch/apply-patch.test.mjs",
    "test:grammar": "node --test plugins/grammar-fix/grammar-fix.test.mjs plugins/grammar-fix/language-alias.test.mjs && node tools/task10-profile/grammar-config-check.mjs",
    "test:grammar:live": "node plugins/grammar-fix/live-check.mjs",
    "test:project-mcp": "node --test plugins/project-mcp/project-mcp.test.mjs",
    "test:research": "node --test plugins/research/*.test.mjs tools/research-activation.test.mjs",
    "research:check": "node tools/research-activation.mjs --check",
    "research:activate": "node tools/research-activation.mjs --write",
    "test:managed-plans": "node --test plugins/managed-plans/*.test.mjs && node tools/task10-profile/refinements-check.mjs",
    "workshop:doctor": "node tools/workshop/bootstrap.mjs --doctor",
    "test:workshop": "node --test tools/workshop/*.test.mjs",
    "test:session": "node --test plugins/session/*test.mjs plugins/companion-api/*test.mjs tools/session-companion/*test.mjs",
    "test:companion-transport": "node --test plugins/companion-transport/*test.mjs tools/session-companion/profile.test.mjs",
    "host:install": "node tools/clean-install/host.mjs --fresh",
    "profile:portable": "node tools/profile-portable.mjs",
    "test:clean-install": "node --test tools/clean-install/*.test.mjs",
    "test:portable": "node --test tools/profile-portable.test.mjs tools/activate.test.mjs tools/resilience/profile.test.mjs",
    "test:resilience": "node --test --test-timeout=120000 plugins/llm-resilience/*.test.mjs plugins/agent-self-heal/tests/*.test.mjs plugins/codex-transient-close/*.test.mjs tools/resilience/*.test.mjs",
    "resilience:doctor": "node tools/resilience/doctor.mjs",
    "prompt:audit": "node tools/prompt-audit/audit.mjs --profile dsh-tui --profile companion",
    "test:prompt-audit": "node --test --test-timeout=300000 tools/prompt-audit/audit.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "yaml": "2.9.1"
  }
}

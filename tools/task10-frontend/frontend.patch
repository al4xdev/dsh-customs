+    .filter(spec => spec.permission !== undefined || spec.sandbox !== undefined || spec.approval !== undefined)
+  const filtered = withoutPlan(modes)
+  return filtered.length > 0 ? filtered : withoutPlan(DEFAULT_SESSION_MODES)
+}
